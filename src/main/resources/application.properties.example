## Exemple de configuration pour MariaDB
## Copier ces variables dans votre environnement ou dans un fichier externe non versionne.

server.port=8081

spring.datasource.url=jdbc:mariadb://localhost:3306/caisse?serverTimezone=UTC
spring.datasource.username=CHANGE_ME
spring.datasource.password=CHANGE_ME
spring.datasource.driver-class-name=org.mariadb.jdbc.Driver

spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MariaDBDialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

app.security.cors.allowed-origins=https://app.caisse-manager.com,https://admin.caisse-manager.com

app.security.jwt-secret=CHANGE_ME_WITH_AT_LEAST_32_CHARACTERS
app.bootstrap.super-admin.username=CHANGE_ME_SUPER_ADMIN_USERNAME
app.bootstrap.super-admin.password=CHANGE_ME
app.bootstrap.super-admin.enabled=false
