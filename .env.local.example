# Copie ce fichier vers .env.local puis adapte les valeurs.
# Ce fichier n'est pas versionne.

# Base locale uniquement (isolee d'AlwaysData)
# Optionnel: si non defini, le script utilise ./data/caisse-db-dev-local-${SERVER_PORT}
# SPRING_DATASOURCE_URL=jdbc:h2:file:./data/caisse-db-dev-local-8080;MODE=MariaDB;DB_CLOSE_ON_EXIT=FALSE
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.H2Dialect

# JWT local
APP_SECURITY_JWT_SECRET=change-this-local-jwt-secret-at-least-32-chars

# Bootstrap super-admin local (cree uniquement s'il est absent)
APP_BOOTSTRAP_SUPER_ADMIN_ENABLED=true
APP_BOOTSTRAP_SUPER_ADMIN_USERNAME=superadmin_local
APP_BOOTSTRAP_SUPER_ADMIN_PASSWORD=change-this-local-password
